<!-- Question 4 — Fix the responsive team section -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Question 4 — Fix the responsive team section</title>
    <style>

* {
    box-sizing: border-box;
}

body {
    margin: 0;
}

.team {
    display: flex;
    flex-flow: row wrap;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 100vh;
    gap: 20px;
    padding: 20px;
}

.member {
    flex: 1 1 280px;
    max-width: 350px;
    min-width: 0;
    min-height: 150px;
    padding: 20px;
    border: 1px solid pink;
    background: #f5f5f5;
}


.member:nth-child(3) {
  order: 3;
}

.member:nth-child(1) {
  order: 2;
}

.member:nth-child(2) {
  order: 1;
}

.member:nth-child(4) {
  order: 4;
}
    </style>
</head>
<body>
    <section class="team">
  <article class="member">
    <h3>Rahul</h3>
    <p>Frontend Developer</p>
  </article>

  <article class="member">
    <h3>Priya</h3>
    <p>Backend Developer</p>
  </article>

  <article class="member">
    <h3>Aman</h3>
    <p>Team Leader</p>
  </article>

  <article class="member">
    <h3>Neha</h3>
    <p>UI/UX Designer</p>
  </article>
</section>
</body>
</html>
